<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Note Taking App</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>


<body>
    <div class="main w-full min-h-screen bg-zinc-900">

        <div class="form p-10">
            <form action="/create" method="post">
                <input class="block w-full px-5 py-3 bg-zinc-800 text-white placeholder:text-zinc-400 border border-zinc-700 rounded-lg outline-none focus:border-blue-500" type="text" placeholder="Title goes here.." name="title">

                <textarea class="block w-full mt-2 px-5 py-3 resize-none bg-zinc-800 text-white placeholder:text-zinc-400 border border-zinc-700 rounded-lg outline-none focus:border-blue-500" placeholder="Write your note here.." rows="5" name="details"></textarea>

                <input class="mt-3 px-5 py-3 bg-blue-600 text-white rounded-lg cursor-pointer hover:bg-blue-700" type="submit" value="Create Task">
            </form>
        </div>

        <div class="tasks-container flex gap-4 flex-wrap p-10">

            <% if (files.length > 0) { %>

                <% files.forEach(function(val) { %>
                    <div class="task-card min-w-72  px-3 py-4 bg-zinc-800 rounded-md">
                        <h1 class="text-white text-3xl tracking-tighter font-semibold">
                            <%= val %>
                        </h1>
                        <a class="text-blue-500 inline-block mt-3" href="">Read More.</a>
                    </div>

                    <% }) %>

                        <%}  else{%>
                            <h3 class="text-zinc-400">No task Yet.</h3>
                            <% } %>

        </div>

    </div>
</body>


</html>